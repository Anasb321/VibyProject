<Window x:Class="VibyApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>

        <!-- Background gradient -->

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <!-- FORM -->

        <Border
            Width="550"
            Padding="40"
            Background="#111827"
            CornerRadius="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock
                    Text="Connexion"
                    FontSize="28"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0 0 0 30"/>


                <!-- EMAIL -->

                <TextBlock
                    Text="Adresse e-mail"
                    Foreground="LightGray"/>

                <TextBox
                    x:Name="txtEmail"
                    Height="35"
                    Margin="0 5 0 20"
                    Background="#1F2937"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="5"/>


                <!-- PASSWORD -->

                <TextBlock
                    Text="Mot de passe"
                    Foreground="LightGray"/>

                <Grid Margin="0 5 0 20">

                    <PasswordBox
                        x:Name="txtPassword"
                        Height="35"
                        Margin="0 5 0 20"
                        Background="#1F2937"
                        BorderThickness="0"
                        Padding="5"/>

                    <TextBox
                        x:Name="txtPasswordVisible"
                        Height="35"
                        Margin="0 5 0 20"
                        Visibility="Hidden"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="5"/>

                    <Button
                        Content="👁"
                        Width="35"
                        Height="35"
                        Margin="0 5 0 20"
                        HorizontalAlignment="Right"
                        Click="TogglePassword"
                        Background="#1F2937"
                        BorderThickness="0"/>

                </Grid>


                <!-- BUTTON -->

                <Button
                    Content="Se connecter"
                    Height="40"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Login_Click"/>


                <!-- ERROR -->

                <TextBlock
                    x:Name="lblError"
                    Foreground="Red"
                    Margin="0 10"
                    TextAlignment="Center"/>


                <!-- REGISTER -->

                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="LightGray"
                    Margin="0 20 0 0">

                    <Run Text="Vous n'avez pas de compte ? "/>

                    <Hyperlink Click="Register_Click">
                        Inscrivez-vous
                    </Hyperlink>

                </TextBlock>

            </StackPanel>

        </Border>

    </Grid>

</Window>