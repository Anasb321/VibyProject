<Window x:Class="VibyApp.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibyApp.UI.ViewModels"
        xmlns:views="clr-namespace:VibyApp.UI.Views"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <views:PlayerBarView DockPanel.Dock="Bottom" 
                             DataContext="{Binding PlayerBarViewModel}"
                             Visibility="{Binding IsPlayerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>