<UserControl x:Class="VibyApp.UI.Views.PlaylistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:converter="clr-namespace:VibyApp.UI.Converters"
             Background="#0F111A">

    <UserControl.Resources>
        <converter:IndexConverter x:Key="IndexConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#07090F" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,30">
                <StackPanel>
                    <TextBlock Text="VIBY" Foreground="#3B82F6" FontSize="32" FontWeight="Black" Margin="10,0,0,40"/>

                    <!-- Bouton Retour -->
                    <Button Command="{Binding NavigateBackCommand}" 
                            HorizontalAlignment="Left" 
                            Margin="60,20,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" Foreground="#3B82F6" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock Text="Retour à la bibliothèque" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- HEADER SECTION -->
                    <Grid Height="350">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1E293B" Offset="0"/>
                                <GradientStop Color="#0F111A" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="60,0,60,40">
                            <!-- ALBUM ART -->
                            <Border Width="220" Height="220" CornerRadius="12" Background="#1F2937" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Playlist.PlaylistPicture}" Stretch="UniformToFill"/>
                                    <Button Content="Changer" 
                                            Command="{Binding ChangeImageCommand}"
                                            Cursor="Hand"
                                            Background="#CC000000" Foreground="White" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- PLAYLIST INFO -->
                            <StackPanel Margin="30,0" VerticalAlignment="Bottom">
                                <TextBlock Text="PLAYLIST" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="2,0,0,5"/>

                                <TextBox Text="{Binding Playlist.Name, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="48" FontWeight="Bold" Foreground="White"
                                         Background="Transparent" BorderThickness="0" Margin="-2,0,0,0"
                                         CaretBrush="White"/>

                                <TextBox Text="{Binding Playlist.Description, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" Foreground="#94A3B8"
                                         Background="Transparent" BorderThickness="0" Margin="0,5,0,20"
                                         CaretBrush="#94A3B8" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 Sauvegarder" Command="{Binding SaveCommand}"
                                            Background="#22C55E" Foreground="White" FontWeight="Bold"
                                            Padding="20,10" Margin="0,0,10,0" BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button Content="➕ Ajouter un titre" 
                                            Command="{Binding AddTrackCommand}"
                                            x:Name="AddButton"
                                            Background="#3B82F6" Foreground="White" FontWeight="Bold"
                                            Padding="20,10" Margin="0,0,10,0"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button Content="🗑 Supprimer playlist"
                                            Command="{Binding DeletePlaylistCommand}"
                                            Background="#EF4444"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="20,10"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                    
                                    <!-- Popup de recherche Deezer -->
                                    <Popup x:Name="SearchPopup" 
                                           IsOpen="{Binding IsSearchOpen}" 
                                           PlacementTarget="{Binding ElementName=AddButton}" 
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="#161B28" BorderBrush="#3B82F6" BorderThickness="1" 
                                                    CornerRadius="12" Width="400" Margin="10">
                                            <StackPanel Margin="15">
                                                <TextBlock Text="Rechercher sur Deezer" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                                                <!-- Barre de recherche -->
                                                <TextBox x:Name="SearchInput" 
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="#0F111A" Foreground="White" Padding="8" BorderThickness="0"/>

                                                <!-- Résultats en temps réel -->
                                                <ListBox ItemsSource="{Binding SearchResults}" 
                                                         Background="Transparent" BorderThickness="0" MaxHeight="300" Margin="0,10,0,0">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding PlacementTarget.DataContext.AddTrackToPlaylistCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                                    <Image Source="{Binding TrackPicture}" Width="40" Height="40"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Artist}" Foreground="#94A3B8" FontSize="10"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- TRACKLIST SECTION -->
                    <StackPanel Margin="60,30">
                        
                        <!-- LIST HEADER -->
                        <Grid Margin="12,0,12,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock Text="TITRE" Grid.Column="1" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock Text="ARTISTE" Grid.Column="2" Foreground="#64748B" FontWeight="Bold"/>
                        </Grid>

                        <Separator Background="#1F2937" Margin="0,0,0,10"/>

                        <!-- ITEMS -->
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TrackRow" CornerRadius="10" Margin="0,4" Background="Transparent">
                                        <Grid Margin="12,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Foreground="#64748B" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource IndexConverter}">
                                                        <Binding />
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="ItemsSource"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            
                                            <TextBlock Text="{Binding Title}" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Artist}" Grid.Column="2" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                            <Button x:Name="BtnDelete" Grid.Column="3" Content="Supprimer" 
                                                     Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}"
                                                     Background="#EF4444" Foreground="White" FontSize="11" 
                                                     Padding="8,4" BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TrackRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1F2937"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>