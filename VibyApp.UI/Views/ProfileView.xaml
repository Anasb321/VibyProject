<UserControl x:Class="VibyApp.UI.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:VibyApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}"
             Background="#07090F">

    <UserControl.Resources>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#07090F" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,30">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="VIBY" Foreground="#3B82F6" FontSize="32" FontWeight="Black" Margin="10,0,0,40" />
                    <Button Content="🏠   Accueil" Style="{StaticResource SidebarButtonStyle}" 
                            Command="{Binding DataContext.MoveToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="🔍   Explorer" Style="{StaticResource SidebarButtonStyle}" 
                            Command="{Binding DataContext.MoveToExploreCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="📚   Bibliothèque" Style="{StaticResource SidebarButtonStyle}" 
                            Command="{Binding DataContext.MoveToLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="👤   Profil" Style="{StaticResource SidebarButtonStyle}" Tag="Active" Margin="0,15,0,0" 
                            Command="{Binding DataContext.MoveToProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="VOS MUSIQUES" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="15,0,0,10" Opacity="0.6"/>
                    <Button Content="❤️  Titres likés" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="📻  Albums" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40">

                <!-- Header Profil -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <Border Width="120" Height="120" CornerRadius="60" BorderBrush="#3B82F6" BorderThickness="2">
                        <Border.Background>
                            <ImageBrush ImageSource="https://api.dicebear.com/7.x/avataaars/png?seed=Anas" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="30,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username, FallbackValue='Utilisateur'}" Foreground="White" FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UserEmail, FallbackValue='anas@student.cvm.qc.ca'}" Foreground="#94A3B8" FontSize="16" Margin="0,5,0,0"/>
                        <Border Background="#3B82F6" HorizontalAlignment="Left" CornerRadius="12" Padding="12,4" Margin="0,15,0,0">
                            <TextBlock Text="MEMBRE PREMIUM" Foreground="White" FontSize="10" FontWeight="Black"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#1F2937" Margin="0,0,0,40"/>

                <!-- Informations -->
                <TextBlock Text="Informations personnelles" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,25"/>

                <UniformGrid Columns="2" Margin="0,0,0,40">
                    <StackPanel Margin="0,10">
                        <TextBlock Text="Membre depuis" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="Mai 2026" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,8"/>
                    </StackPanel>
                    <StackPanel Margin="0,10">
                        <TextBlock Text="Localisation" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="Montréal, Canada" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,8"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Paramètres -->
                <TextBlock Text="Préférences" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Border Background="#0F172A" CornerRadius="16" Padding="25" BorderBrush="#1F2937" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="Mode Sombre" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Optimise l'interface pour les environnements sombres" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Separator Background="#1F2937" Margin="0,20"/>

                        <DockPanel Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="Qualité Audio" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Haute fidélité (Lossless)" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Modifier" Foreground="#3B82F6" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,50,0,0">
                    <Button Content="Modifier le profil" Height="45" Width="180" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Déconnexion" Height="45" Width="180" Margin="20,0" Background="Transparent" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>