<UserControl x:Class="VibyApp.UI.Views.MediaBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VibyApp.ViewModels;assembly=VibyApp.ViewModels"
             xmlns:views="clr-namespace:VibyApp.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:MediaBarView}"> <Grid Height="110">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="550" Padding="10" Background="#111827" CornerRadius="35">
            <StackPanel Orientation="Vertical">
                
                <!--TODO valeur a changer -->
                             
                <StackPanel Margin="0,0,0,1">
                    <ProgressBar Value="3" 
                                 Maximum="30" 
                                 Height="10" 
                                 Background="#1E293B" 
                                 Foreground="#38BDF8" 
                                 BorderThickness="0"/>
                    <Grid Margin="0,5">
                        <TextBlock Text="temps" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Left"/>
                        <TextBlock Text="0:30" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
        
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Image Source="/Views/image/previous.png" Height="30" Stretch="Uniform" Margin="5" />
                    </Button>
            
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0">
                        <Image Source="/Views/image/play.png" Height="45" Stretch="Uniform" Margin="5"/>
                    </Button>
            
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Image Source="/Views/image/next.png" Height="30" Stretch="Uniform" Margin="5"/>
                    </Button>
                </StackPanel>
        
            </StackPanel>
        </Border>
    </Grid>
</UserControl>