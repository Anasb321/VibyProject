<UserControl x:Class="VibyApp.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VibyApp.ViewModels;assembly=VibyApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="450" Padding="40" Background="#111827" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Connexion" FontSize="28" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0 0 0 30"/>

                <TextBlock Text="Adresse e-mail" Foreground="LightGray" Margin="0 0 0 5"/>
                <TextBox x:Name="txtEmail" Height="35" Margin="0 0 0 20" 
                         Background="#1F2937" Foreground="White" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Mot de passe" Foreground="LightGray" Margin="0 0 0 5"/>
                <Grid Margin="0 0 0 25">
                    <PasswordBox x:Name="txtPassword" Height="35" Background="#1F2937" 
                                 Foreground="White" BorderThickness="0" Padding="5,5,40,5"/>

                    <TextBox x:Name="txtPasswordVisible" Height="35" Background="#1F2937" 
                             Foreground="White" BorderThickness="0" Padding="5,5,40,5" 
                             Visibility="Collapsed"/>

                    <Button Content="👁" Width="35" Height="35" HorizontalAlignment="Right" 
                            Background="Transparent" Foreground="Gray" BorderThickness="0" 
                            Click="TogglePassword" Cursor="Hand"/>
                </Grid>

                <Button Content="Se connecter" Height="40" Background="#2563EB" 
                        Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Click="Login_Click" Cursor="Hand"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" Margin="0 15 0 0" 
                           TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>

                <TextBlock HorizontalAlignment="Center" Foreground="LightGray" Margin="0 20 0 0">
                    <Run Text="Vous n'avez pas de compte ? "/>
                    <Hyperlink Click="Register_Click" Foreground="#60A5FA">Inscrivez-vous</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>