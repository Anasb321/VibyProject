<UserControl x:Class="VibyApp.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:VibyApp.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel, IsDesignTimeCreatable=False}">
    <Grid>

        <!-- Arrière-plan avec dégradé -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <!-- Formulaire central -->
        <Border
            Width="650"
            Padding="40"
            Background="#111827"
            CornerRadius="15"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Connexion"
                           FontSize="28"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <!-- IDENTIFIANT (EMAIL OU USERNAME) -->
                <TextBlock Text="Nom d'utilisateur ou E-mail"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtIdentifier"
                         Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         Margin="0 0 0 20"
                         Background="#1F2937"
                         Foreground="White"
                         BorderThickness="1"
                         BorderBrush="#374151"
                         Padding="10,8"
                         VerticalContentAlignment="Center"/>

                <!-- MOT DE PASSE -->
                <TextBlock Text="Mot de passe"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,5"/>

                <Grid Margin="0 0 0 20">

                    <PasswordBox x:Name="txtPassword"
                                 Height="40"
                                 Background="#1F2937"
                                 Foreground="White"
                                 BorderThickness="1"
                                 BorderBrush="#374151"
                                 Padding="10,8"
                                 VerticalContentAlignment="Center"/>

                    <TextBox x:Name="txtPasswordVisible"
                             Height="40"
                             Visibility="Collapsed"
                             Background="#1F2937"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="#374151"
                             Padding="10,8"
                             VerticalContentAlignment="Center"/>

                    <Button Content="👁"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Right"
                            Click="TogglePassword"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <!-- BOUTON CONNEXION -->
                <Button Content="Se connecter"
                        Height="45"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        BorderThickness="0"
                        Click="Login_Click"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- MESSAGE D'ERREUR -->
                <TextBlock x:Name="lblError"
                           Text="{Binding ErrorMessage}"
                           Foreground="#EF4444"
                           Margin="0,15,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- LIEN INSCRIPTION -->
                <TextBlock HorizontalAlignment="Center"
                           Foreground="#9CA3AF"
                           Margin="0 25 0 0">
                    
                    <Run Text="Pas encore de compte ?"/>

                    <Hyperlink Click="Register_Click" Foreground="#3B82F6" TextDecorations="None">
                        Inscrivez-vous
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>