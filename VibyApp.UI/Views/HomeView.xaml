<UserControl x:Class="VibyApp.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:VibyApp.UI.ViewModels"
             xmlns:converters="clr-namespace:VibyApp.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#0F111A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolToVis"/>
        <converters:UriToImageConverter x:Key="UriToImage"/>
        <converters:FavoriteHeartForegroundConverter x:Key="FavoriteHeartBrush"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.2"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F445E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlbumCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="#161B2C" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252D48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GenreTile" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Margin="15" 
                                       VerticalAlignment="Bottom"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TrackCardTemplate">
            <Border Style="{StaticResource AlbumCard}">
                <Grid>
                    <Button Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <StackPanel>
                            <Border CornerRadius="10" Height="166" Width="166" Margin="0,0,0,12" ClipToBounds="True">
                                <Image Source="{Binding Track.Album.CoverUrl, Converter={StaticResource UriToImage}}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Track.Title}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Track.Artist.Name}" Foreground="#718096" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="#1F2937" BorderThickness="0" Cursor="Hand" Opacity="0.95"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Ajouter aux titres aimés">
                        <TextBlock Text="♥" FontSize="18" FontWeight="Bold"
                                   Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteHeartBrush}}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#07090F" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,30">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="VIBY" Foreground="#3B82F6" FontSize="32" FontWeight="Black" Margin="10,0,0,40" />
                    <Button Content="🏠   Accueil" Style="{StaticResource SidebarButtonStyle}" Tag="Active" Command="{Binding DataContext.MoveToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="🔍   Explorer" Style="{StaticResource SidebarButtonStyle}" Command="{Binding DataContext.MoveToExploreCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="📚   Bibliothèque" Style="{StaticResource SidebarButtonStyle}" Command="{Binding DataContext.MoveToLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="👤   Profil" Style="{StaticResource SidebarButtonStyle}" Margin="0,15,0,0" Command="{Binding DataContext.MoveToProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="VOS MUSIQUES" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="15,0,0,10" Opacity="0.6"/>
                    <Button Content="❤️  Titres likés" Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding DataContext.MoveToLikedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="📻  Albums" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Width="450" Height="42" Background="#1A1D29" CornerRadius="12" HorizontalAlignment="Left" Margin="40,0" BorderBrush="#2D3748" BorderThickness="1" VerticalAlignment="Center">
                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             VerticalAlignment="Center"
                             CaretBrush="White"
                             FontSize="14"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Rechercher un titre, un artiste..."/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,10,40,40">

                    <TextBlock Text="Chargement..."
                               Foreground="#94A3B8"
                               Margin="0,10,0,15"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <!-- Résultats de recherche -->
                    <StackPanel Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,10,0,15">
                            <TextBlock Text="Résultats de recherche" Foreground="White" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="Recherche en cours..."
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <ScrollViewer x:Name="SearchScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource TrackCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="Aucun résultat pour cette recherche."
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSearching}" Value="False"/>
                                                <Condition Binding="{Binding SearchResults.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Contenu d'accueil (masqué pendant la recherche) -->
                    <StackPanel Visibility="{Binding IsSearchMode, Converter={StaticResource InverseBoolToVis}}">

                    <Grid Margin="0,10,0,15">
                        <TextBlock Text="Musiques Populaires" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TracksLeftBtn" Content="‹" Style="{StaticResource NavButton}" Margin="0,0,8,0" Click="ScrollTracksLeft_Click" IsEnabled="False"/>
                            <Button x:Name="TracksRightBtn" Content="›" Style="{StaticResource NavButton}" Click="ScrollTracksRight_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="TracksScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="Scroll_Changed">
                        <ItemsControl ItemsSource="{Binding TopTracks}" ItemTemplate="{StaticResource TrackCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Margin="0,45,0,15">
                        <TextBlock Text="Artistes Populaires" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ArtistsLeftBtn" Content="‹" Style="{StaticResource NavButton}" Margin="0,0,8,0" Click="ScrollArtistsLeft_Click" IsEnabled="False"/>
                            <Button x:Name="ArtistsRightBtn" Content="›" Style="{StaticResource NavButton}" Click="ScrollArtistsRight_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="ArtistsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="Scroll_Changed">
                        <ItemsControl ItemsSource="{Binding TopArtists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="0,0,25,0" Cursor="Hand">
                                        <Ellipse Width="130" Height="130" HorizontalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding PictureUrl, Converter={StaticResource UriToImage}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Margin="0,45,0,15">
                        <TextBlock Text="Parcourir par genre" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="GenresLeftBtn" Content="‹" Style="{StaticResource NavButton}" Margin="0,0,8,0" Click="ScrollGenresLeft_Click" IsEnabled="False"/>
                            <Button x:Name="GenresRightBtn" Content="›" Style="{StaticResource NavButton}" Click="ScrollGenresRight_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="GenresScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="Scroll_Changed">
                        <ItemsControl ItemsSource="{Binding Genres}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Background="{Binding Background}"
                                            Style="{StaticResource GenreTile}"
                                            Command="{Binding DataContext.SearchGenreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
