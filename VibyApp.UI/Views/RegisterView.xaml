<UserControl x:Class="VibyApp.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VibyApp.ViewModels;assembly=VibyApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="620" Padding="40" Background="#111827" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Créer un compte" FontSize="28" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0 0 0 25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nom" Foreground="LightGray" Margin="0 0 0 5"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1F2937" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Prénom" Foreground="LightGray" Margin="0 0 0 5"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1F2937" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 15 0 0">
                            <TextBlock Text="Nom d'utilisateur" Foreground="LightGray" Margin="0 0 0 5"/>
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1F2937" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0 15 0 0">
                            <TextBlock Text="Adresse e-mail" Foreground="LightGray" Margin="0 0 0 5"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1F2937" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0 15 0 0">
                            <TextBlock Text="Mot de passe" Foreground="LightGray" Margin="0 0 0 5"/>
                            <Grid>
                                <PasswordBox x:Name="txtPassword" Height="35" Background="#1F2937" Foreground="White" 
                     BorderThickness="0" Padding="5,5,40,5" PasswordChanged="txtPassword_PasswordChanged"/>

                                <TextBox x:Name="txtPasswordVisible" Height="35" Background="#1F2937" Foreground="White" 
                 BorderThickness="0" Padding="5,5,40,5" Visibility="Collapsed" 
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="👁" Width="35" Height="35" HorizontalAlignment="Right" 
                Background="Transparent" Foreground="Gray" BorderThickness="0" 
                Click="TogglePassword_Click" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0 15 0 0">
                            <TextBlock Text="Confirmer le mot de passe" Foreground="LightGray" Margin="0 0 0 5"/>
                            <Grid>
                                <PasswordBox x:Name="txtConfirmPassword" Height="35" Background="#1F2937" Foreground="White" 
                     BorderThickness="0" Padding="5,5,40,5" PasswordChanged="txtConfirmPassword_PasswordChanged"/>

                                <TextBox x:Name="txtConfirmPasswordVisible" Height="35" Background="#1F2937" Foreground="White" 
                 BorderThickness="0" Padding="5,5,40,5" Visibility="Collapsed"
                 Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="👁" Width="35" Height="35" HorizontalAlignment="Right" 
                Background="Transparent" Foreground="Gray" BorderThickness="0" 
                Click="ToggleConfirmPassword_Click" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Button Content="S'inscrire" Command="{Binding RegisterCommand}" Height="40" Margin="0 30 0 0" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" Margin="0 10" 
                               TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>

                    <TextBlock HorizontalAlignment="Center" Foreground="LightGray" Margin="0 10 0 0">
                        <Run Text="Déjà membre ? "/>
                        <Hyperlink Command="{Binding GoToLoginCommand}" Foreground="#60A5FA">Connectez-vous</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>