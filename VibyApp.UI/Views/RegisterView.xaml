<UserControl x:Class="VibyApp.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VibyApp.ViewModels;assembly=VibyApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            Width="550"
            Padding="40"
            Background="#111827"
            CornerRadius="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock
                        Text="Créer un compte"
                        FontSize="28"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 25"/>

                    <TextBlock Text="Nom complet" Foreground="LightGray"/>
                    <TextBox
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Height="35" Margin="0 5 0 15"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="5"/>

                    <TextBlock Text="Nom d'utilisateur" Foreground="LightGray"/>
                    <TextBox
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                        Height="35" Margin="0 5 0 15"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="5"/>

                    <TextBlock Text="Adresse e-mail" Foreground="LightGray"/>
                    <TextBox
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Height="35" Margin="0 5 0 15"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="5"/>

                    <TextBlock Text="Mot de passe" Foreground="LightGray"/>
                    <PasswordBox
                        x:Name="txtPassword"
                        Height="35" Margin="0 5 0 15"
                        Background="#1F2937" Foreground="White"
                        BorderThickness="0" Padding="5"/>

                    <Button
                        Content="S'inscrire"
                        Height="40" Margin="0 15 0 0"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="Red"
                        Margin="0 10"
                        TextAlignment="Center"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="LightGray"
                        Margin="0 10 0 0">
                        <Run Text="Déjà membre ? "/>
                        <Hyperlink Click="Login_Click">
                            Connectez-vous
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>