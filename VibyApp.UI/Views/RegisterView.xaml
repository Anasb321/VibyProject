<UserControl x:Class="VibyApp.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:VibyApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}">

    <Grid>
        <!-- Arrière-plan dégradé moderne -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="0.3"/>
                <GradientStop Color="#1E293B" Offset="0.6"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="650" Padding="40" Background="#111827" CornerRadius="15"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#1F2937" BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.4" ShadowDepth="0"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>

                    <!-- Titre et Sous-titre -->
                    <TextBlock Text="Rejoindre Viby" FontSize="32" Foreground="White" 
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 5"/>
                    <TextBlock Text="Créez votre compte pour commencer" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" Margin="0 0 0 30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nom -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Nom" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=Nom}"/>
                            </TextBlock>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Background="#1F2937" Foreground="White" 
                                     BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <!-- Prénom -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Prénom" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=Prénom}"/>
                            </TextBlock>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Background="#1F2937" Foreground="White" 
                                     BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <!-- Nom d'utilisateur -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 20 0 0">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Nom d'utilisateur" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=utilisateur}"/>
                            </TextBlock>
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Background="#1F2937" Foreground="White" 
                                     BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0 20 0 0">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Email" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=mail}"/>
                            </TextBlock>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Background="#1F2937" Foreground="White" 
                                     BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <!-- Mot de passe -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0 20 0 0">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Mot de passe" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=passe}"/>
                            </TextBlock>
                            <Grid>
                                <PasswordBox x:Name="txtPassword" Height="40" Background="#1F2937" Foreground="White" 
                                             BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" 
                                             Padding="10,0,40,0" PasswordChanged="txtPassword_PasswordChanged"/>

                                <TextBox x:Name="txtPasswordVisible" Height="40" Background="#1F2937" Foreground="White" 
                                         BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" 
                                         Padding="10,0,40,0" Visibility="Collapsed" 
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="👁" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Background="Transparent" Foreground="#64748B" BorderThickness="0" 
                                        Click="TogglePassword_Click" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>

                        <!-- Confirmer Mot de passe -->
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0 20 0 0">
                            <TextBlock Margin="0 0 0 8" FontSize="13">
                                <Run Text="Confirmer" Foreground="#94A3B8"/>
                                <Run Text=" *" Foreground="{Binding ErrorMessage, Converter={StaticResource StringToColorConverter}, ConverterParameter=correspond}"/>
                            </TextBlock>
                            <Grid>
                                <PasswordBox x:Name="txtConfirmPassword" Height="40" Background="#1F2937" Foreground="White" 
                                             BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" 
                                             Padding="10,0,40,0" PasswordChanged="txtConfirmPassword_PasswordChanged"/>

                                <TextBox x:Name="txtConfirmPasswordVisible" Height="40" Background="#1F2937" Foreground="White" 
                                         BorderThickness="1" BorderBrush="#374151" VerticalContentAlignment="Center" 
                                         Padding="10,0,40,0" Visibility="Collapsed"
                                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="👁" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Background="Transparent" Foreground="#64748B" BorderThickness="0" 
                                        Click="ToggleConfirmPassword_Click" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Message d'erreur -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" Margin="0 20 0 0" 
                               TextAlignment="Center" TextWrapping="Wrap" MinHeight="20" FontWeight="SemiBold"/>

                    <!-- Bouton d'inscription -->
                    <Button Content="Créer le compte" 
                            Command="{Binding RegisterCommand}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Height="45" Margin="0 15 0 0" Cursor="Hand"
                            Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Lien retour connexion -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 25 0 0">
                        <TextBlock Text="Déjà un compte ?" Foreground="#94A3B8"/>
                        <Button Command="{Binding GoToLoginCommand}" Content="Se connecter" 
                                Background="Transparent" BorderThickness="0" Foreground="#3B82F6" 
                                Margin="5,0,0,0" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>