<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        Title="Inscription" Height="500" Width="800" 
        Background="#1F2E4A" WindowStartupLocation="CenterScreen">

    <Grid>
        <Border Background="#243A5E" Width="350" Padding="30" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Inscription" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Nom complet" Foreground="White" Margin="0,10,0,5"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#5F6F89" Foreground="White" BorderThickness="0" Padding="10"/>

                <TextBlock Text="Nom d'utilisateur" Foreground="White" Margin="0,10,0,5"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#5F6F89" Foreground="White" BorderThickness="0" Padding="10"/>

                <TextBlock Text="Adresse e-mail" Foreground="White" Margin="0,10,0,5"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#5F6F89" Foreground="White" BorderThickness="0" Padding="10"/>

                <TextBlock Text="Mot de passe" Foreground="White" Margin="0,15,0,5"/>
                <PasswordBox x:Name="PassBox" Height="35" Background="#5F6F89" Foreground="White" BorderThickness="0" Padding="10"/>

                <TextBlock Text="Confirmer mot de passe" Foreground="White" Margin="0,15,0,5"/>
                <PasswordBox x:Name="ConfirmPassBox" Height="35" Background="#5F6F89" Foreground="White" BorderThickness="0" Padding="10"/>

                <Button Command="{Binding InscriptionCommand}" 
            CommandParameter="{Binding ElementName=PassBox}"
            Content="S'inscrire" Height="40" Margin="0,25,0,0" 
            Background="#0D1B3D" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>